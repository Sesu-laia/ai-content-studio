    I --> J["Tampilkan gambar terpilih,<br/>siap dijadikan video di Tahap 2"]
    E1 --> K["Tampilkan pesan [ERROR], kembali ke menu"]
    E2 --> K
    E3 --> K
    J --> Z((Selesai))
    K --> Z
