flowchart TD
    A((Mulai)) --> B[/"Pengguna memilih menu 2: Generate gambar"/]
    B --> C[/"Pengguna mengisi prompt dan style"/]
    C --> D{"Prompt tidak kosong<br/>dan style dikenal?"}
    D -- tidak --> E["Raise PipelineException IMAGE_GEN"]
    D -- ya --> F["_build_full_prompt(): gabung prompt + style modifier"]
    F --> G{"Provider aktif?"}
    G -- mock --> H["Buat data gambar offline"]
    G -- dalle --> J{"OPENAI_API_KEY ada?"}
    J -- tidak --> E
    J -- ya --> K["Kirim request ke OpenAI DALL-E"]
    K --> L{"Respons berhasil<br/>dan berisi url gambar?"}
    L -- tidak --> E
    L -- ya --> M["Ambil url gambar dari respons"]
    H --> N["Buat objek GeneratedImage"]
    M --> N
    N --> O["Buat ContentProject, tambah gambar,<br/>simpan ke daftar project"]
    O --> P["Tampilkan info gambar + estimasi biaya"]
    E --> Q["Tampilkan pesan [ERROR], kembali ke menu"]
    P --> Z((Selesai))
    Q --> Z
